# Copiez ce fichier en .streamlit/secrets.toml puis remplissez-le.
# secrets.toml est dans .gitignore : il ne partira JAMAIS sur GitHub.

# Clé API Claude (console.anthropic.com). Facultatif : sans clé,
# l'app fonctionne avec les recettes de base, sans génération IA.
ANTHROPIC_API_KEY = "sk-ant-..."

# Connexion Auth0 (e-mail + Google). Sans cette section, l'app
# démarre en « mode démo local » (connexion par simple e-mail, sans mot de passe).
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "une-longue-chaine-aleatoire"   # python -c "import secrets; print(secrets.token_hex(32))"
client_id = "VOTRE_CLIENT_ID_AUTH0"
client_secret = "VOTRE_CLIENT_SECRET_AUTH0"
server_metadata_url = "https://VOTRE-DOMAINE.auth0.com/.well-known/openid-configuration"
